<Ui xmlns="http://www.blizzard.com/wow/ui/"
   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
   xsi:schemaLocation="http://www.blizzard.com/wow/ui/ ..\..\FrameXML\UI.xsd">

  <!-- Main guild panel shell. Size, backdrop, scripts, and dynamic elements set in Lua. -->
  <Frame name="GuildWeaveGuildPanel" inherits="BackdropTemplate"
         frameStrata="MEDIUM" movable="true" enableMouse="true" hidden="true">
    <!-- Size computed from column widths; position restored from DB in Lua. -->
    <Layers>
      <Layer level="BACKGROUND">
        <Texture name="$parentTitleBg">
          <!-- Width determined by TOPLEFT/TOPRIGHT anchors; height set in Lua (TITLE_H - 4). -->
          <Anchors>
            <Anchor point="TOPLEFT" relativePoint="TOPLEFT" x="4" y="-4"/>
            <Anchor point="TOPRIGHT" relativePoint="TOPRIGHT" x="-4" y="-4"/>
          </Anchors>
          <Color r="0.12" g="0.12" b="0.12" a="1"/>
        </Texture>
      </Layer>
      <Layer level="ARTWORK">
        <!-- Divider at y=-(TITLE_H + COL_H + 3) = -45 -->
        <Texture name="$parentDivider">
          <Anchors>
            <Anchor point="TOPLEFT" relativePoint="TOPLEFT" x="8" y="-45"/>
            <Anchor point="TOPRIGHT" relativePoint="TOPRIGHT" x="-8" y="-45"/>
          </Anchors>
          <Color r="0.4" g="0.4" b="0.4" a="0.7"/>
        </Texture>
      </Layer>
      <Layer level="OVERLAY">
        <Texture name="$parentTitleIcon">
          <Size x="18" y="18"/>
          <Anchors>
            <Anchor point="LEFT" relativeTo="$parentTitleBg" relativePoint="LEFT" x="4" y="0"/>
          </Anchors>
          <!-- File set in Lua from Constants.MEDIA.GUILD_LOGO. -->
        </Texture>
        <FontString name="$parentTitleText" inherits="GameFontNormal">
          <Anchors>
            <Anchor point="LEFT" relativeTo="$parentTitleIcon" relativePoint="RIGHT" x="4" y="0"/>
          </Anchors>
          <!-- Text and color set in Lua. -->
        </FontString>
        <FontString name="$parentCountLabel" inherits="GameFontNormalSmall">
          <Anchors>
            <Anchor point="RIGHT" relativeTo="$parentTitleBg" relativePoint="RIGHT" x="-28" y="0"/>
          </Anchors>
          <!-- Text and color set in Lua. -->
        </FontString>
      </Layer>
    </Layers>
    <Frames>
      <!-- Scroll area: top at -(TITLE_H + COL_H + 6) = -48; bottom leaves room for filter button. -->
      <ScrollFrame name="$parentScroll">
        <Anchors>
          <Anchor point="TOPLEFT" relativePoint="TOPLEFT" x="8" y="-48"/>
          <Anchor point="BOTTOMRIGHT" relativePoint="BOTTOMRIGHT" x="-8" y="30"/>
        </Anchors>
        <!-- OnMouseWheel script and scroll child set in Lua. -->
      </ScrollFrame>
      <!-- OnClick overridden in Lua to also close filter panels. -->
      <Button name="$parentCloseBtn" inherits="UIPanelCloseButton">
        <Size x="20" y="20"/>
        <Anchors>
          <Anchor point="TOPRIGHT" relativePoint="TOPRIGHT" x="-2" y="-2"/>
        </Anchors>
      </Button>
      <!-- Text and OnClick set in Lua. -->
      <Button name="$parentFilterBtn" inherits="UIPanelButtonTemplate">
        <Size x="70" y="20"/>
        <Anchors>
          <Anchor point="BOTTOMRIGHT" relativePoint="BOTTOMRIGHT" x="-8" y="6"/>
        </Anchors>
      </Button>
    </Frames>
  </Frame>

</Ui>
