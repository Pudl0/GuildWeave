<Ui xmlns="http://www.blizzard.com/wow/ui/"
   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
   xsi:schemaLocation="http://www.blizzard.com/wow/ui/ ..\..\FrameXML\UI.xsd">

  <!-- Death log shell. Backdrop, scripts, and dynamic rows are set in Lua. -->
  <Frame name="Deathlog" inherits="BackdropTemplate"
         frameStrata="MEDIUM" movable="true" resizable="true"
         enableMouse="true" hidden="true">
    <!-- Size and position restored from DB in Lua. -->
    <Layers>
      <Layer level="BACKGROUND">
        <Texture name="$parentHeaderBg">
          <Anchors>
            <Anchor point="TOPLEFT" relativePoint="TOPLEFT" x="4" y="-4"/>
            <Anchor point="TOPRIGHT" relativePoint="TOPRIGHT" x="-4" y="-4"/>
          </Anchors>
          <Color r="0.1" g="0.1" b="0.1" a="0.8"/>
        </Texture>
      </Layer>
      <Layer level="OVERLAY">
        <FontString name="$parentTitle" inherits="GameFontNormal">
          <Anchors>
            <Anchor point="LEFT" relativeTo="$parentHeaderBg" relativePoint="LEFT" x="20" y="0"/>
          </Anchors>
          <!-- Text and color set in Lua from Localization. -->
        </FontString>
        <!-- Column headers positioned dynamically in UpdateDeathlogLayout. -->
        <FontString name="$parentColHeader1" inherits="GameFontNormal"/>
        <FontString name="$parentColHeader2" inherits="GameFontNormal"/>
        <FontString name="$parentColHeader3" inherits="GameFontNormal"/>
      </Layer>
    </Layers>
    <Frames>
      <!-- Decorative icon top-left. FrameLevel and mask textures set in Lua. -->
      <Frame name="$parentIcon">
        <Size x="24" y="24"/>
        <Anchors>
          <Anchor point="TOPLEFT" relativePoint="TOPLEFT" x="-6" y="6"/>
        </Anchors>
        <Layers>
          <Layer level="BORDER">
            <Texture name="$parentBorder">
              <Anchors>
                <Anchor point="TOPLEFT" relativePoint="TOPLEFT"/>
                <Anchor point="BOTTOMRIGHT" relativePoint="BOTTOMRIGHT"/>
              </Anchors>
              <Color r="0.1" g="0" b="0" a="0.9"/>
            </Texture>
          </Layer>
          <Layer level="ARTWORK">
            <Texture name="$parentBg">
              <Size x="20" y="20"/>
              <Anchors>
                <Anchor point="CENTER" relativePoint="CENTER"/>
              </Anchors>
              <!-- File set in Lua from Constants.MEDIA.MINIMAP_ICON. -->
            </Texture>
          </Layer>
        </Layers>
      </Frame>
      <!-- Resize grip. OnMouseDown/Up scripts set in Lua (smart-resize logic). -->
      <Button name="$parentResizeGrip">
        <Size x="16" y="16"/>
        <Anchors>
          <Anchor point="BOTTOMRIGHT" relativePoint="BOTTOMRIGHT" x="-2" y="2"/>
        </Anchors>
        <NormalTexture file="Interface\ChatFrame\UI-ChatIM-SizeGrabber-Up"/>
        <HighlightTexture file="Interface\ChatFrame\UI-ChatIM-SizeGrabber-Highlight"/>
        <PushedTexture file="Interface\ChatFrame\UI-ChatIM-SizeGrabber-Down"/>
      </Button>
    </Frames>
  </Frame>

</Ui>
