<Ui xmlns="http://www.blizzard.com/wow/ui/"
   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
   xsi:schemaLocation="http://www.blizzard.com/wow/ui/ ..\..\FrameXML\UI.xsd">

  <!-- Inactivity window shell. Backdrop, column headers, and rows set in Lua. -->
  <Frame name="GuildWeaveInactivityWindow" inherits="BackdropTemplate"
         frameStrata="MEDIUM" movable="true" enableMouse="true" hidden="true">
    <Size x="650" y="450"/>
    <Anchors>
      <Anchor point="CENTER" relativeTo="UIParent" relativePoint="CENTER"/>
    </Anchors>
    <Layers>
      <Layer level="OVERLAY">
        <FontString name="$parentHeader" inherits="GameFontHighlightLarge">
          <Anchors>
            <Anchor point="TOP" relativePoint="TOP" x="0" y="-15"/>
          </Anchors>
        </FontString>
      </Layer>
    </Layers>
    <Frames>
      <Button name="$parentCloseBtn" inherits="UIPanelCloseButton">
        <Size x="22" y="22"/>
        <Anchors>
          <Anchor point="TOPRIGHT" relativePoint="TOPRIGHT" x="-7" y="-7"/>
        </Anchors>
      </Button>
      <ScrollFrame name="$parentScrollFrame" inherits="UIPanelScrollFrameTemplate">
        <Anchors>
          <Anchor point="TOPLEFT" relativePoint="TOPLEFT" x="15" y="-50"/>
          <Anchor point="BOTTOMRIGHT" relativePoint="BOTTOMRIGHT" x="-30" y="15"/>
        </Anchors>
      </ScrollFrame>
    </Frames>
  </Frame>

</Ui>
