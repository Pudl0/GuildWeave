<Ui xmlns="http://www.blizzard.com/wow/ui/"
   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
   xsi:schemaLocation="http://www.blizzard.com/wow/ui/ ..\..\FrameXML\UI.xsd">

  <!-- Officer panel shell. Backdrop, tab bar, tab content, and scripts set in Lua
       (tab bar built dynamically by GuildWeave.Shared.CreateTabSwitcher). -->
  <Frame name="GuildWeaveOfficerPanel" inherits="BackdropTemplate"
         frameStrata="DIALOG" movable="true" enableMouse="true" hidden="true">
    <Size x="480" y="420"/>
    <Anchors>
      <Anchor point="CENTER" relativeTo="UIParent" relativePoint="CENTER"/>
    </Anchors>
    <Layers>
      <Layer level="OVERLAY">
        <FontString name="$parentTitle" inherits="GameFontNormalLarge">
          <Anchors>
            <Anchor point="TOP" relativePoint="TOP" x="0" y="-12"/>
          </Anchors>
        </FontString>
      </Layer>
    </Layers>
    <Frames>
      <Button name="$parentCloseBtn" inherits="UIPanelCloseButton">
        <Size x="20" y="20"/>
        <Anchors>
          <Anchor point="TOPRIGHT" relativePoint="TOPRIGHT" x="-2" y="-2"/>
        </Anchors>
      </Button>
    </Frames>
  </Frame>

</Ui>
