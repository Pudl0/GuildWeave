<Ui xmlns="http://www.blizzard.com/wow/ui/"
   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
   xsi:schemaLocation="http://www.blizzard.com/wow/ui/ ..\FrameXML\UI.xsd">

  <!-- Shared template for announcement popups (death, level-up, cap).      -->
  <!-- Backdrop, colours, text content, and animation delays are set in Lua. -->
  <Frame name="AnnouncementFrameTemplate" virtual="true"
         inherits="BackdropTemplate" frameStrata="FULLSCREEN_DIALOG" hidden="true">
    <Size x="380" y="200"/>
    <Anchors>
      <Anchor point="TOP" relativeTo="UIParent" relativePoint="TOP"/>
    </Anchors>
    <Layers>
      <Layer level="ARTWORK">
        <Texture name="$parentIcon">
          <Size x="96" y="96"/>
          <Anchors>
            <Anchor point="TOP" relativePoint="TOP" x="0" y="-14"/>
          </Anchors>
        </Texture>
      </Layer>
      <Layer level="OVERLAY">
        <FontString name="$parentHeader" inherits="GameFontNormalLarge">
          <Anchors>
            <Anchor point="TOP" relativeTo="$parentIcon" relativePoint="BOTTOM" x="0" y="-20"/>
          </Anchors>
        </FontString>
        <FontString name="$parentBodyText" inherits="GameFontHighlight"
                    justifyH="CENTER" justifyV="TOP">
          <Anchors>
            <Anchor point="TOP"   relativeTo="$parentHeader" relativePoint="BOTTOM" x="0" y="-8"/>
            <Anchor point="LEFT"  relativePoint="LEFT"  x="12"  y="0"/>
            <Anchor point="RIGHT" relativePoint="RIGHT" x="-12" y="0"/>
          </Anchors>
          <Shadow>
            <Color r="0" g="0" b="0"/>
            <Offset x="1" y="-1"/>
          </Shadow>
        </FontString>
      </Layer>
    </Layers>
    <Animations>
      <AnimationGroup name="$parentAnimGroup">
        <Translation name="$parentMoveDown"      duration="0.6" offsetX="0" offsetY="-50" smoothing="OUT"/>
        <Translation name="$parentMoveDownAgain" duration="0.8" offsetX="0" offsetY="-50" smoothing="IN"/>
        <Alpha       name="$parentFadeIn"        duration="0.5" fromAlpha="0" toAlpha="1" smoothing="IN"/>
        <Alpha       name="$parentFadeOut"       duration="1.5" fromAlpha="1" toAlpha="0" smoothing="OUT"/>
      </AnimationGroup>
    </Animations>
  </Frame>

  <Frame name="DeathMessageFrame" inherits="AnnouncementFrameTemplate" frameLevel="1000"/>
  <Frame name="LevelUpFrame"      inherits="AnnouncementFrameTemplate" frameLevel="999"/>

  <!-- PvP warning: simpler two-text layout, no icon or animation group.     -->
  <!-- Fade/hide is handled via UIFrameFadeOut in Global.lua.                 -->
  <Frame name="GuildWeavePvPFrame" inherits="BackdropTemplate"
         frameStrata="FULLSCREEN_DIALOG" movable="true" enableMouse="true" hidden="true">
    <Size x="320" y="110"/>
    <Anchors>
      <Anchor point="CENTER" relativeTo="UIParent" relativePoint="CENTER"/>
    </Anchors>
    <Layers>
      <Layer level="OVERLAY">
        <FontString name="GuildWeavePvPFrameTitle" inherits="GameFontNormalLarge">
          <Anchors>
            <Anchor point="TOP" relativePoint="TOP" x="0" y="-20"/>
          </Anchors>
        </FontString>
        <FontString name="GuildWeavePvPFrameName" inherits="GameFontHighlight">
          <Anchors>
            <Anchor point="BOTTOM" relativePoint="BOTTOM" x="0" y="25"/>
          </Anchors>
        </FontString>
      </Layer>
    </Layers>
  </Frame>

</Ui>
