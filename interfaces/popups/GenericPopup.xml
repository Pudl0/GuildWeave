<Ui xmlns="http://www.blizzard.com/wow/ui/"
   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
   xsi:schemaLocation="http://www.blizzard.com/wow/ui/ ..\..\FrameXML\UI.xsd">

  <!-- Popup frame for rule-block and cap notifications.       -->
  <!-- Backdrop colours and text content are set in Lua.       -->
  <Frame name="GuildWeavePopupFrame" inherits="BackdropTemplate"
         frameStrata="DIALOG" movable="true" enableMouse="true" hidden="true">
    <Size x="370" y="160"/>
    <Anchors>
      <Anchor point="TOP" relativeTo="UIParent" relativePoint="TOP" x="0" y="-150"/>
    </Anchors>
    <Layers>
      <Layer level="ARTWORK">
        <Texture name="$parentIcon">
          <Size x="40" y="40"/>
          <Anchors>
            <Anchor point="TOP" relativePoint="TOP" x="0" y="-30"/>
          </Anchors>
        </Texture>
      </Layer>
      <Layer level="OVERLAY">
        <FontString name="$parentTitle" inherits="GameFontNormalLarge">
          <Anchors>
            <Anchor point="TOP" relativeTo="$parentIcon" relativePoint="BOTTOM" x="0" y="-5"/>
          </Anchors>
        </FontString>
        <FontString name="$parentMessage" inherits="GameFontNormalLarge"
                    justifyH="CENTER">
          <Size x="320" y="0"/>
          <Anchors>
            <Anchor point="TOP" relativeTo="$parentTitle" relativePoint="BOTTOM" x="0" y="-5"/>
          </Anchors>
        </FontString>
      </Layer>
    </Layers>
  </Frame>

</Ui>
