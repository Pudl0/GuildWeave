{
  "$schema": "https://raw.githubusercontent.com/LuaLS/vscode-lua/master/setting/schema.json",
  "runtime": {
    "version": "Lua 5.1"
  },
  "diagnostics": {
    "globals": ["GuildWeave", "GuildWeavePopupFrame", "GuildWeaveSetupWizard", "GuildWeavePvPFrame", "DeathMessageFrame", "LevelUpFrame", "SlashCmdList", "GuildWeaveOfficerPanel", "GuildWeaveInactivityWindow"]
  },
  "workspace": {
    "library": ["/path/to/wow-api/Annotations"],
    "ignoreDir": ["libs"]
  }
}
